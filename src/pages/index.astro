
<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Spud Station · Cashier POS</title>
    <meta name="theme-color" content="#FDB813" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/spud-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/spud-icon.svg" />
  </head>
  <body>
<main class="pos-shell" aria-label="Spud Station point of sale">
  <div class="crt-overlay" aria-hidden="true"></div>
  <header class="top-bar">
    <a class="brand" href="/">SPUD<br /><span>STATION</span></a>
    <div class="shift-status"><span class="status-light"></span> COUNTER 01 · OPEN</div>
    <a class="admin-link" href="/admin">ADMIN MODE ↗</a>
  </header>

  <section class="pos-layout">
    <section class="products-panel" aria-labelledby="products-heading">
      <div class="section-heading">
        <p>BUILD AN ORDER</p>
        <h1 id="products-heading">PICK YOUR LOADOUT</h1>
      </div>
      <div id="product-catalogue"><p class="catalogue-message">LOADING LIVE MENU…</p></div>
    </section>

    <aside class="cart-panel" aria-labelledby="cart-heading">
      <div class="cart-header">
        <p>ACTIVE TICKET</p>
        <h2 id="cart-heading">ORDER <span>#001</span></h2>
      </div>
      <div id="cart-items" class="cart-items"><p class="empty-cart">SELECT A SPUD TO START.</p></div>
      <div class="cart-summary">
        <div><span>ITEMS</span><strong id="item-count">0</strong></div>
        <div class="total-row"><span>TOTAL</span><strong id="cart-total">RM 0.00</strong></div>
      </div>
      <button id="checkout-button" class="checkout-button" type="button" disabled>CHECKOUT <span>→</span></button>
    </aside>
  </section>
</main>
<dialog id="payment-dialog" class="payment-dialog" aria-labelledby="payment-heading">
  <div class="payment-dialog__title"><p>FINAL STEP</p><h2 id="payment-heading">CHOOSE PAYMENT</h2></div>
  <p class="payment-total">TOTAL DUE <strong id="payment-total">RM 0.00</strong></p>
  <div class="payment-options">
    <button type="button" class="payment-option" data-payment="cash"><span>01</span> CASH</button>
    <button type="button" class="payment-option" data-payment="qr"><span>02</span> QR PAYMENT</button>
  </div>
  <div class="payment-actions"><button id="cancel-payment" type="button" class="cancel-payment">CANCEL</button><button id="confirm-payment" type="button" class="confirm-payment" disabled>CONFIRM PAYMENT →</button></div>
</dialog>
  </body>
</html>

<script>
  import { POSController } from '../lib/POSController.js';
  import { DatabaseService } from '../lib/DatabaseService.js';

  const money = new Intl.NumberFormat('en-MY', { style: 'currency', currency: 'MYR' });
  if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  new POSController({
    formatCurrency: (amount) => money.format(amount),
    database: url && anonKey ? new DatabaseService(url, anonKey) : null,
    elements: {
      products: document.querySelector('#product-catalogue'),
      items: document.querySelector('#cart-items'),
      count: document.querySelector('#item-count'),
      total: document.querySelector('#cart-total'),
      checkout: document.querySelector('#checkout-button'),
      paymentDialog: document.querySelector('#payment-dialog'),
      paymentTotal: document.querySelector('#payment-total'),
      paymentOptions: document.querySelectorAll('[data-payment]'),
      confirmPayment: document.querySelector('#confirm-payment'),
      cancelPayment: document.querySelector('#cancel-payment'),
    },
  }).initialise();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap');
  :root { --potato: #8B5A2B; --cheddar: #FDB813; --cream: #F5F5F5; --ink: #000; --tomato: #E24B2B; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--potato); color: var(--ink); font-family: 'Space Mono', monospace; }
  button, a { font: inherit; }
  button { cursor: pointer; }
  .pos-shell { min-height: 100vh; padding: 18px; position: relative; overflow: hidden; }
  .crt-overlay { pointer-events:none; position:fixed; z-index:10; inset:0; opacity:.045; background:linear-gradient(to bottom, transparent 0 3px, rgba(0,0,0,.85) 3px 4px); background-size:100% 4px; }
  .top-bar, .pos-layout { position: relative; z-index: 1; }
  .top-bar { display: grid; grid-template-columns: 1fr auto auto; gap: 22px; align-items: center; border: 4px solid var(--ink); background: var(--cheddar); box-shadow: 6px 6px 0 var(--ink); padding: 12px 16px; }
  .brand, h1, h2, .checkout-button { font-family: 'Press Start 2P', monospace; }
  .brand { color: var(--ink); text-decoration: none; font-size: 17px; line-height: 1.05; } .brand span { color: var(--cream); text-shadow: 2px 2px var(--ink); }
  .shift-status { font-weight: 700; font-size: 12px; background: var(--cream); border: 3px solid var(--ink); padding: 9px; } .status-light { display: inline-block; width: 10px; height: 10px; background: #73B951; border: 2px solid var(--ink); }
  .admin-link { color: var(--ink); font-weight: 700; font-size: 12px; }
  .pos-layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(320px, 3fr); gap: 18px; margin-top: 18px; }
  .products-panel, .cart-panel { border: 4px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .products-panel { background: var(--cream); padding: 22px; } .section-heading p, .cart-header p { margin: 0 0 8px; color: var(--potato); font-size: 12px; font-weight: 700; letter-spacing: .08em; }
  h1 { margin: 0; font-size: clamp(20px, 3vw, 34px); line-height: 1.3; } h2 { margin: 0; font-size: 15px; line-height: 1.5; }
  .product-group { border-top: 4px solid var(--ink); margin-top: 22px; padding-top: 14px; } .product-group h2 { display: inline-block; background: var(--potato); color: var(--cream); padding: 8px 10px; }
  .catalogue-message { margin:26px 0; padding:18px; border:3px solid var(--ink); background:var(--cheddar); font-weight:700; font-size:12px; line-height:1.8; }
  .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 13px; margin-top: 14px; }
  .product-button { min-height: 112px; display: flex; flex-direction: column; justify-content: space-between; text-align: left; border: 4px solid var(--ink); border-radius: 0; background: var(--cheddar); padding: 15px; box-shadow: 4px 4px 0 var(--ink); font-weight: 700; } .product-button:hover { background: #ffcc38; transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); } .product-button:active { transform: translate(4px, 4px); box-shadow: 0 0 0 var(--ink); }
  .product-button strong { align-self: flex-end; background: var(--ink); color: var(--cream); padding: 5px 7px; font-size: 13px; }
  .cart-panel { background: var(--ink); color: var(--cream); display: flex; flex-direction: column; min-height: 680px; padding: 18px; } .cart-header { border-bottom: 3px dashed var(--cheddar); padding-bottom: 16px; } .cart-header p { color: var(--cheddar); } .cart-header h2 span { color: var(--cheddar); }
  .cart-items { flex: 1; padding: 10px 0; } .empty-cart { color: #a6a6a6; font-size: 12px; line-height: 1.7; }
  .cart-item { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 10px; border-bottom: 2px solid #434343; padding: 12px 0; font-size: 12px; } .cart-item small { display: block; color: var(--cheddar); margin-top: 5px; } .quantity-control { display: flex; align-items: center; gap: 7px; } .quantity-control button { width: 26px; height: 26px; padding: 0; border: 2px solid var(--cream); border-radius: 0; background: var(--ink); color: var(--cream); font-size: 18px; line-height: 1; } .quantity-control button:hover { background: var(--cheddar); color: var(--ink); }
  .cart-summary { border-top: 4px solid var(--cream); padding-top: 13px; } .cart-summary div { display: flex; justify-content: space-between; padding: 4px 0; font-weight: 700; } .total-row { align-items: baseline; color: var(--cheddar); font-family: 'Press Start 2P', monospace; font-size: 13px; } .total-row strong { font-size: 20px; }
  .checkout-button { border: 4px solid var(--ink); border-radius: 0; background: var(--tomato); color: var(--cream); font-size: 15px; margin-top: 18px; min-height: 74px; box-shadow: 4px 4px 0 var(--cheddar); } .checkout-button:not(:disabled):hover { background: #ff5a36; } .checkout-button:not(:disabled):active { transform: translate(4px, 4px); box-shadow: 0 0 0 var(--cheddar); } .checkout-button:disabled { background: #6d6d6d; color: #bbb; cursor: not-allowed; box-shadow: 4px 4px 0 #444; }
  .payment-dialog { width:min(550px,calc(100% - 24px)); border:5px solid var(--ink); border-radius:0; background:var(--cream); color:var(--ink); padding:20px; box-shadow:9px 9px 0 var(--ink); } .payment-dialog::backdrop { background:rgba(0,0,0,.72); } .payment-dialog__title { border-bottom:4px solid var(--ink); padding-bottom:13px; } .payment-dialog__title p { margin:0 0 7px; color:var(--potato); font-size:11px; font-weight:700; letter-spacing:.08em; } .payment-total { display:flex; justify-content:space-between; align-items:baseline; margin:18px 0; font-weight:700; } .payment-total strong { color:var(--potato); font-family:'Press Start 2P',monospace; font-size:18px; } .payment-options { display:grid; grid-template-columns:1fr 1fr; gap:12px; } .payment-option { min-height:95px; border:4px solid var(--ink); border-radius:0; background:var(--cheddar); box-shadow:4px 4px 0 var(--ink); font-family:'Press Start 2P',monospace; font-size:12px; } .payment-option span { display:block; margin-bottom:10px; font-family:'Space Mono',monospace; font-size:11px; } .payment-option.is-selected { background:var(--potato); color:var(--cream); transform:translate(4px,4px); box-shadow:none; } .payment-actions { display:grid; grid-template-columns:1fr 2fr; gap:12px; margin-top:20px; } .payment-actions button { min-height:56px; border:4px solid var(--ink); border-radius:0; font-family:'Press Start 2P',monospace; font-size:10px; } .cancel-payment { background:var(--cream); } .confirm-payment { background:var(--tomato); color:var(--cream); box-shadow:4px 4px 0 var(--ink); } .confirm-payment:disabled { background:#777; color:#ddd; box-shadow:none; cursor:not-allowed; }
  @media (max-width: 820px) { .pos-shell { padding: 10px; } .top-bar { grid-template-columns: 1fr auto; } .shift-status { display: none; } .pos-layout { grid-template-columns: 1fr; } .cart-panel { min-height: 430px; } }
</style>
