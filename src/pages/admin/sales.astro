---
---
<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Spud Station · Sales Data</title><meta name="theme-color" content="#FDB813" />
    <link rel="manifest" href="/site.webmanifest" /><link rel="icon" href="/spud-icon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="sales-shell">
      <div class="scanlines" aria-hidden="true"></div>
      <header class="sales-header"><a href="/admin" class="brand">SPUD<br /><span>STATION</span></a><div><small>REPORTING TERMINAL</small><h1>SALES DATA</h1></div><a href="/admin" class="back-link">← ADMIN MODE</a></header>
      <p id="notice" class="sync-status">CONNECTING TO SUPABASE…</p>
      <section class="kpis" aria-label="Current sales figures"><article><span>LIVE REVENUE</span><strong id="daily-revenue">RM 0.00</strong></article><article><span>COMPLETED ORDERS</span><strong id="order-count">0</strong></article><article><span>AVERAGE TICKET</span><strong id="average-ticket">RM 0.00</strong></article></section>
      <section class="closeout-bar"><div><small>END-OF-DAY CHECK</small><h2>SALES CLOSEOUT</h2></div><button id="run-closeout" type="button">RUN DAILY CLOSEOUT</button></section>
      <section id="closeout-report" class="closeout-report" aria-live="polite"><div class="closeout-total"><span>CURRENT TOTAL</span><strong id="closeout-total">RM 0.00</strong><small id="closeout-orders">0 PAID TICKETS</small></div><div><span>CASH COLLECTED</span><strong id="cash-total">RM 0.00</strong></div><div><span>QR COLLECTED</span><strong id="qr-total">RM 0.00</strong></div></section>
      <section class="history-panel"><div class="panel-title"><small>PERMANENT RECORD</small><h2>SALES CLOSEOUT HISTORY</h2></div><div class="table-wrap"><table><thead><tr><th>DATE</th><th>CLOSED</th><th>TICKETS</th><th>CASH</th><th>QR</th><th>TOTAL</th></tr></thead><tbody id="closeout-history"><tr><td colspan="6" class="muted">Loading history…</td></tr></tbody></table></div></section>
      <section class="sales-grid"><article class="panel"><div class="panel-title"><small>CURRENT PERIOD</small><h2>TOP SELLERS</h2></div><ol id="best-sellers" class="leaderboard"><li class="muted">Loading sales data…</li></ol></article><article class="panel"><div class="panel-title"><small>LIVE FEED</small><h2>RECENT ORDERS</h2></div><div class="table-wrap"><table><thead><tr><th>TICKET</th><th>TIME</th><th>PAYMENT</th><th>TOTAL</th></tr></thead><tbody id="recent-orders"><tr><td colspan="4" class="muted">Loading orders…</td></tr></tbody></table></div></article></section>
    </main>
    <script>
      import { DatabaseService } from '../../lib/DatabaseService.js';
      import { SalesController } from '../../lib/SalesController.js';
      if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      const url = import.meta.env.PUBLIC_SUPABASE_URL; const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY; const notice = document.querySelector('#notice');
      if (!url || !anonKey) { notice.textContent = 'ADD SUPABASE KEYS TO .ENV TO START'; notice.classList.add('is-error'); }
      else new SalesController({ database: new DatabaseService(url, anonKey), formatCurrency: (amount) => new Intl.NumberFormat('en-MY', { style: 'currency', currency: 'MYR' }).format(amount), elements: { notice, revenue: document.querySelector('#daily-revenue'), orderCount: document.querySelector('#order-count'), average: document.querySelector('#average-ticket'), bestSellers: document.querySelector('#best-sellers'), recentOrders: document.querySelector('#recent-orders'), closeout: document.querySelector('#run-closeout'), closeoutReport: document.querySelector('#closeout-report'), closeoutTotal: document.querySelector('#closeout-total'), cashTotal: document.querySelector('#cash-total'), qrTotal: document.querySelector('#qr-total'), closeoutOrders: document.querySelector('#closeout-orders'), closeoutHistory: document.querySelector('#closeout-history') } }).initialise();
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap');
  :root{--potato:#8B5A2B;--cheddar:#FDB813;--cream:#F5F5F5;--ink:#000;--alert:#E24B2B}*{box-sizing:border-box}body{margin:0;background:var(--potato);color:var(--ink);font-family:'Space Mono',monospace}.sales-shell{min-height:100vh;padding:18px;position:relative}.scanlines{pointer-events:none;position:fixed;inset:0;z-index:10;opacity:.045;background:linear-gradient(to bottom,transparent 0 3px,rgba(0,0,0,.85) 3px 4px);background-size:100% 4px}.sales-header,.sync-status,.kpis,.closeout-bar,.closeout-report,.history-panel,.sales-grid{position:relative;z-index:1}.sales-header{display:grid;grid-template-columns:1fr 2fr auto;gap:18px;align-items:center;padding:14px 18px;border:4px solid var(--ink);background:var(--cheddar);box-shadow:6px 6px 0 var(--ink)}.brand,h1,h2{font-family:'Press Start 2P',monospace}.brand{color:var(--ink);text-decoration:none;font-size:16px;line-height:1.05}.brand span{color:var(--cream);text-shadow:2px 2px var(--ink)}h1,h2{margin:4px 0 0;line-height:1.45}h1{font-size:clamp(17px,2vw,26px)}h2{font-size:14px}.back-link{color:var(--ink);font-size:12px;font-weight:700}.sales-header small,.panel-title small{font-weight:700;letter-spacing:.08em}.sync-status{display:inline-block;margin:20px 0 12px;padding:6px 9px;background:var(--ink);color:var(--cheddar);font-size:11px;font-weight:700}.sync-status.is-error{background:var(--alert);color:var(--cream)}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.kpis article,.panel,.history-panel{border:4px solid var(--ink);box-shadow:5px 5px 0 var(--ink)}.kpis article{background:var(--cream);padding:16px}.kpis article:nth-child(2){background:var(--cheddar)}.kpis span{display:block;font-weight:700;font-size:11px}.kpis strong{display:block;margin-top:14px;font-family:'Press Start 2P',monospace;font-size:clamp(16px,2vw,23px);line-height:1.3}.closeout-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:16px;border:4px solid var(--ink);background:var(--ink);color:var(--cream);padding:14px 18px;box-shadow:5px 5px 0 var(--ink)}.closeout-bar small{color:var(--cheddar);font-size:11px;font-weight:700}button{border:3px solid var(--ink);border-radius:0;background:var(--cheddar);padding:10px 14px;box-shadow:3px 3px 0 var(--ink);font:700 12px 'Space Mono',monospace;cursor:pointer}button:active{transform:translate(3px,3px);box-shadow:none}.closeout-report{display:grid;grid-template-columns:1.5fr 1fr 1fr;margin-top:16px;border:4px solid var(--ink);box-shadow:5px 5px 0 var(--ink);background:var(--cream)}.closeout-report div{padding:15px;border-right:3px solid var(--ink)}.closeout-report div:last-child{border-right:0}.closeout-report span,.closeout-report small{display:block;font-size:11px;font-weight:700}.closeout-report strong{display:block;margin-top:9px;color:var(--potato);font-family:'Press Start 2P',monospace;font-size:16px;line-height:1.5}.closeout-total{background:var(--cheddar)}.closeout-total strong{color:var(--ink)!important}.closeout-report small{margin-top:7px}.history-panel,.panel{margin-top:16px;background:var(--cream);padding:18px}.panel-title{border-bottom:3px solid var(--ink);padding-bottom:11px}.panel-title small{color:var(--potato)}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:12px}th,td{text-align:left;border-bottom:2px solid var(--ink);padding:13px 8px}th{background:var(--ink);color:var(--cream);white-space:nowrap}.sales-grid{display:grid;grid-template-columns:1fr 1.5fr;gap:16px}.sales-grid .panel{margin-top:16px}.leaderboard{margin:0;padding:0;list-style:none}.leaderboard li{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;border-bottom:3px solid var(--ink);padding:15px 0;font-weight:700}.leaderboard b{padding:7px;background:var(--cheddar);border:2px solid var(--ink)}.leaderboard strong{font-size:12px}.muted{color:#666;font-size:12px;padding:12px 0}@media(max-width:760px){.sales-shell{padding:10px}.sales-header{grid-template-columns:1fr auto}.sales-header>div{grid-column:1/-1;grid-row:2}.kpis,.sales-grid,.closeout-report{grid-template-columns:1fr}.closeout-bar{align-items:stretch;flex-direction:column}.closeout-report div{border-right:0;border-bottom:3px solid var(--ink)}.closeout-report div:last-child{border-bottom:0}.back-link{font-size:10px}}
</style>
